# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
# O .env.local é ignorado pelo git: as chaves reais nunca vão para o GitHub.
# Em produção, cadastre as mesmas variáveis na Vercel (Settings → Environment Variables).
#
# Atenção: toda variável VITE_* vai parar no JavaScript público do site.
# Coloque aqui só chaves feitas para serem públicas — nunca a service_role.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key

# Cloudflare Turnstile → Site Key (opcional; sem ela o login não tem CAPTCHA)
VITE_TURNSTILE_SITE_KEY=
